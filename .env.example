# Safe default: runs without a model server.
AISHA_PROFILE=mock

# Runtime state stays outside Git.
AISHA_DATA_DIR=../../.aisha-data

AISHA_HOST=127.0.0.1
AISHA_PORT=8000
AISHA_LOG_LEVEL=INFO

# Optional machine-local overrides:
# AISHA_LLM_PROVIDER=ollama
# AISHA_LLM_MODEL=qwen3.5:35b-mlx
# AISHA_LLM_BASE_URL=http://127.0.0.1:11434
# AISHA_LLM_API_KEY=

# Optional local camera perception. Prefer .\Start-AISHA.ps1 -Vision on Windows.
# AISHA_VISION_PROVIDER=local-mediapipe
# AISHA_VISION_CAMERA_INDEX=0
# AISHA_VISION_MODEL_PATH=
# AISHA_VISION_OBJECT_DETECTION=true
# AISHA_VISION_OBJECT_MODEL_PATH=

# Optional local speech synthesis. Prefer .\Start-AISHA.ps1 -Voice on Windows.
# AISHA_TTS_PROVIDER=local-kokoro
# AISHA_TTS_VOICE=af_heart
# AISHA_TTS_MODEL_PATH=
# AISHA_TTS_VOICES_PATH=
