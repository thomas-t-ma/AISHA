# Safe default: runs without a model server.
AISHA_PROFILE=mock

# Runtime state stays outside Git.
AISHA_DATA_DIR=../../.aisha-data

AISHA_HOST=127.0.0.1
AISHA_PORT=8000
AISHA_LOG_LEVEL=INFO

# Optional machine-local overrides:
# AISHA_LLM_PROVIDER=ollama
# AISHA_LLM_MODEL=qwen3.5:35b-mlx
# AISHA_LLM_BASE_URL=http://127.0.0.1:11434
# AISHA_LLM_API_KEY=
